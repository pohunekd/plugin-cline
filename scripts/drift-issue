#!/usr/bin/env bash
# Opens or updates the one open drift issue from a scripts/drift-check report.
#
# The issue is found by its label, not by a search, so a rerun right after a
# run sees it. An open issue is updated in place (its body becomes the latest
# report) and gets a comment when the release changed; otherwise one issue is
# created. Nothing in the repository is edited.
#
# Requires: gh (authenticated, with issues write on the repository), jq.
set -euo pipefail

TITLE="Cline drift: the newest release differs from the committed evidence"
# DRIFT_ISSUE_LABEL points a --dry-run lookup at another label (to see the
# update path against an existing issue); the workflow never sets it.
LABEL="${DRIFT_ISSUE_LABEL:-cline-drift}"
LABEL_COLOR="D93F0B"
LABEL_DESCRIPTION="A scheduled capture of the newest Cline release differs from compat/"
# GitHub rejects an issue body above 65536 characters.
MAX_BODY_CHARS=60000
# Read-back of a created issue: attempts and seconds between them.
READBACK_ATTEMPTS=24
READBACK_DELAY=5

usage() {
  cat <<'EOF'
usage: scripts/drift-issue --repo OWNER/REPO --report FILE [--dry-run]
       scripts/drift-issue --report FILE --body-only
       scripts/drift-issue --self-test

  --repo OWNER/REPO  the repository that holds the issue
  --report FILE      the report written by scripts/drift-check
  --dry-run          look up the open issue, print the body and what would happen
  --body-only        print the issue body (no gh); also used for the job summary
  --self-test        check the body of an oversized report (no gh)
EOF
}

die() {
  printf 'drift-issue: %s\n' "$*" >&2
  exit 1
}

log() {
  printf 'drift-issue: %s\n' "$*" >&2
}

# open_issues: the open issues that carry the label, oldest first, as
# `number TAB release-marker` lines.
open_issues() {
  # The REST listing is read-after-write consistent; `gh issue list --label`
  # goes through the search index, which lags behind a fresh issue.
  gh api --paginate "repos/$REPO/issues?labels=$LABEL&state=open&per_page=100" \
    --jq '.[] | select(has("pull_request") | not) | {number, body: (.body // "")}' |
    jq -rs 'sort_by(.number)[] | "\(.number)\t\(((.body | capture("<!-- drift-release: (?<r>[0-9.]+) -->")?) // {r: ""}).r)"'
}

# body: the issue body for the report.
body() {
  local run=""
  if [[ -n "${GITHUB_SERVER_URL:-}" && -n "${GITHUB_REPOSITORY:-}" && -n "${GITHUB_RUN_ID:-}" ]]; then
    run="Run: ${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}"$'\n\n'
  fi
  # The report holds text the captured CLI produced, so it is published only
  # inside a code fence longer than any backtick run in it: no markup, mention
  # or link in it is live.
  local fence
  fence="$(awk '{ while (match($0, /`+/)) { if (RLENGTH > m) m = RLENGTH; $0 = substr($0, RSTART + RLENGTH) } }
    END { n = (m < 3 ? 3 : m + 1); s = ""; for (i = 0; i < n; i++) s = s "`"; print s }' "$REPORT")"
  {
    printf '<!-- drift-release: %s -->\n' "$release"
    printf 'Cline %s differs from the committed evidence.\n\n' "$release"
    printf '%s text\n' "$fence"
    # The marker line is re-emitted above from the validated release. The
    # report is cut at a line boundary (awk reads the file, so no pipe closes
    # early) and says so, because GitHub rejects a body above its limit.
    LC_ALL=C awk -v max="$MAX_BODY_CHARS" '
      index($0, "<!-- drift-release: ") == 1 { next }
      { n += length($0) + 1; if (n > max) { cut = 1; exit } print }
      END { if (cut) print "[truncated at " max " bytes; the full report is in the drift workflow artifact]" }' "$REPORT"
    printf '%s\n\n%s' "$fence" "$run"
    # shellcheck disable=SC2016 # the backticks are markdown, not a substitution
    printf 'The scheduled capture compared a fresh `scripts/capture` run with `compat/`. It edits nothing: review the differences, then follow "Updating to a new Cline release" in the README (capture, review, commit the evidence, move the lock).\n'
  }
}

# self_test: the body of an oversized report stays below GitHub's limit, says
# it was cut, ends on a whole line and keeps its code fence closed; a report
# without any backtick also gets a fence.
self_test() {
  local report out lines
  SELF_TEST_DIR="$(mktemp -d "${TMPDIR:-/tmp}/drift-issue-selftest.XXXXXX")"
  trap 'rm -rf "$SELF_TEST_DIR"' EXIT
  local dir="$SELF_TEST_DIR"
  report="$dir/report.md"
  out="$dir/body.md"
  awk 'BEGIN {
    print "<!-- drift-release: 1.2.3 -->"
    print "Cline 1.2.3 differs from the committed evidence (release 1.2.2) in 1 place(s)."
    print "\nscreens big/120"
    for (i = 0; i < 5000; i++) print "    + line " i " @octocat ```` <b>x</b> \303\244\303\244\303\244 padding padding padding"
  }' >"$report"
  "$0" --report "$report" --body-only >"$out" || die "self test: the oversized report failed (rc $?)"
  (($(wc -c <"$out") < 65536)) || die "self test: the body is over GitHub's limit"
  grep -q '^\[truncated at ' "$out" || die "self test: the cut is not announced"
  lines="$(grep -c '^`\{5,\}' "$out" || true)"
  [[ "$lines" == 2 ]] || die "self test: the code fence is not opened and closed once ($lines fence lines)"
  grep -q 'padding$' <(grep -B1 '^\[truncated' "$out") || die "self test: the cut is not at a line boundary"
  printf '<!-- drift-release: 1.2.3 -->\nCline 1.2.3 differs from the committed evidence.\n\nscreens a/1\n    no backticks here\n' >"$report"
  "$0" --report "$report" --body-only >"$out" || die "self test: a report without backticks failed (rc $?)"
  [[ "$(grep -c '^```' "$out" || true)" == 2 ]] || die "self test: no fence around a report without backticks"
  log "self test passed"
}

main() {
  REPO=""
  REPORT=""
  local dry=0 body_only=0 found number marker release count attempt tmp
  while (($# > 0)); do
    case "$1" in
      --body-only)
        body_only=1
        shift
        ;;
      --self-test)
        self_test
        exit 0
        ;;
      --repo | --report)
        (($# > 1)) || die "$1 needs a value"
        case "$1" in
          --repo) REPO="$2" ;;
          --report) REPORT="$2" ;;
        esac
        shift 2
        ;;
      --dry-run)
        dry=1
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  [[ -f "$REPORT" ]] || die "--report FILE is required and must exist"
  if ((body_only == 0)); then
    [[ "$REPO" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || die "--repo OWNER/REPO is required"
    command -v gh >/dev/null 2>&1 || die "missing tool: gh"
    command -v jq >/dev/null 2>&1 || die "missing tool: jq"
  fi
  release="$(sed -n 's/^<!-- drift-release: \([0-9.]*\) -->$/\1/p' "$REPORT" | head -n 1)"
  [[ -n "$release" ]] || die "the report has no drift-release marker"
  grep -q 'differs from the committed evidence' "$REPORT" || {
    log "the report records no difference; nothing to do"
    exit 0
  }

  if ((body_only == 1)); then
    body
    exit 0
  fi

  found="$(open_issues)"
  count="$(grep -c . <<<"$found" || true)"
  tmp="$(mktemp "${TMPDIR:-/tmp}/drift-issue.XXXXXX")"
  BODY_FILE="$tmp"
  trap 'rm -f "$BODY_FILE"' EXIT
  body >"$tmp"
  if ((dry == 1)); then
    cat "$tmp"
  fi

  if ((count == 0)); then
    if ((dry == 1)); then
      log "dry run: would create an issue \"$TITLE\" for $release"
      exit 0
    fi
    gh label create "$LABEL" --repo "$REPO" --color "$LABEL_COLOR" --description "$LABEL_DESCRIPTION" --force >/dev/null
    gh issue create --repo "$REPO" --title "$TITLE" --label "$LABEL" --body-file "$tmp" >/dev/null
    # The effect is read back: exactly one open issue carries the label. The
    # label listing lags a few seconds behind a new issue, and a run that ends
    # before the issue is listed would let the next run create a second one,
    # so this waits until it shows.
    for ((attempt = 1; attempt <= READBACK_ATTEMPTS; attempt++)); do
      count="$(open_issues | grep -c . || true)"
      ((count >= 1)) && break
      sleep "$READBACK_DELAY"
    done
    ((count == 1)) || die "expected one open $LABEL issue after creating it, found $count"
    log "created the drift issue for $release"
    exit 0
  fi

  IFS=$'\t' read -r number marker <<<"$(head -n 1 <<<"$found")"
  ((count == 1)) || log "warning: $count open $LABEL issues; updating the oldest (#$number)"
  if ((dry == 1)); then
    log "dry run: would update #$number (recorded release ${marker:-unknown}) for $release"
    exit 0
  fi
  gh issue edit "$number" --repo "$REPO" --body-file "$tmp" >/dev/null
  if [[ "$marker" != "$release" ]]; then
    gh issue comment "$number" --repo "$REPO" --body "The newest release is now $release (the issue was last updated for ${marker:-an unknown release}); the description holds the latest comparison." >/dev/null
  fi
  log "updated #$number for $release"
}

main "$@"
