#!/usr/bin/env bash
# End-to-end check of the Cline package against a pohunek build: links
# `package/` into an isolated daemon, installs core's `cline-hook-v1` reporter,
# launches the Cline release installed under --cline-prefix through the
# package's own launch path (no CLINE_SANDBOX* variable is set by this script)
# and asserts launch, input, status, approval refusal, resume, local placement
# beside a running Cline hub, the reported session reference across `/clear`
# and `/fork`, a reported subagent, and that install, doctor and uninstall
# leave a foreign hook byte-identical.
#
# Everything (daemon, workers, Cline, the model stub) runs in user, network,
# mount, UTS and PID namespaces: only a loopback interface, a private process
# tree that ends with the run, empty tmpfs mounts over the operator's ~/.cline
# and over the pohunek directory of the host runtime dir (the daemon's
# pathname sockets are not scoped to a network namespace), and a HOME,
# CLINE_DIR, hub port and hub discovery path below --root. No credential,
# login or real model is involved: the turns go to `scripts/model-stub` on the
# loopback with a placeholder key. The operator's daemon and Cline hub are
# unreachable from the namespace and are never touched.
#
#   scripts/smoke --root DIR --core-bin DIR --cline-prefix DIR
#
#   --root          scratch directory (created, reused only when it carries the
#                   marker this script writes)
#   --core-bin      directory with the pohunek, pohunekd and pohunek-sessiond
#                   binaries of a core build that has the runtime features the
#                   package requires
#   --cline-prefix  npm global prefix of the release in compat/RELEASE, as
#                   `scripts/capture install` lays it out (`bin/cline`,
#                   `lib/node_modules/cline`); it is copied, never run in place
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(dirname "$SCRIPT_DIR")"

# Seconds each wait loop polls before it fails, and the poll interval.
WAIT_SECONDS=60
POLL_SECONDS=0.5
FAST_POLL_SECONDS=0.25
# Seconds the stub holds the first reply so `working` is observable.
HOLD_SECONDS=8
# Initial-input acknowledgement window of `session new`, in milliseconds.
INPUT_ACK_MS=8000
# Bound on waiting for the daemon after teardown.
REAP_SECONDS=10
# Time a refused input gets to reach Cline before its effect is checked.
REFUSAL_SETTLE_SECONDS=2
# Loopback ports inside the namespace: the model stub and the private hub port.
STUB_PORT=18083
HUB_PORT=27463
# Provider configuration for the stub; the key is a placeholder, not a secret.
STUB_KEY=smoke-placeholder-not-a-key
STUB_MODEL=stub-model
# File the stub's scripted command creates in the workspace once approved.
APPROVAL_MARKER=smoke-approved
PROMPT="smoke prompt"
# Characters a path may hold; the namespace commands carry paths as arguments.
SAFE_PATH_RE='^[A-Za-z0-9._/+-]+$'

ROOT="" CORE_BIN="" CLINE_PREFIX=""
DAEMON_PID="" STUB_PID=""

log() { printf 'smoke: %s\n' "$*" >&2; }
die() {
  log "FAIL: $*"
  exit 1
}
safe_path() { # <what> <path>
  [[ "$2" =~ $SAFE_PATH_RE ]] || die "$1 holds a character outside letters, digits, . _ + - /: $2"
}

usage() {
  sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d;s/^# \{0,1\}//' >&2
  exit 2
}

while (($# > 0)); do
  case "$1" in
    --root) ROOT="${2:?}"; shift 2 ;;
    --core-bin) CORE_BIN="${2:?}"; shift 2 ;;
    --cline-prefix) CLINE_PREFIX="${2:?}"; shift 2 ;;
    -h | --help) usage ;;
    *) usage ;;
  esac
done
[[ -n "$ROOT" && -n "$CORE_BIN" && -n "$CLINE_PREFIX" ]] || usage

RELEASE="$(sed -n 's/^release=//p' "$REPO/compat/RELEASE")"
BIN_SHA="$(sed -n 's/^@cline\/cli-linux-x64\.bin\.sha256=//p' "$REPO/compat/RELEASE")"

# --- host stage: checks, scratch root, namespace --------------------------

if [[ "${SMOKE_STAGE:-host}" == host ]]; then
  for tool in unshare ip jq sha256sum cp git readlink sed python3 pgrep hostname node; do
    command -v "$tool" >/dev/null 2>&1 || die "missing tool: $tool"
  done
  unshare --help 2>&1 | grep -q -- '--map-user' || die "unshare lacks --map-user (util-linux 2.38 or later)"
  for bin in pohunek pohunekd pohunek-sessiond; do
    [[ -x "$CORE_BIN/$bin" ]] || die "$CORE_BIN/$bin is not executable"
  done
  safe_path --root "$ROOT"
  safe_path "the checkout path" "$REPO"
  MARKER=.cline-plugin-smoke-root
  mkdir -p "$ROOT"
  ROOT="$(cd "$ROOT" && pwd -P)"
  safe_path "the resolved --root" "$ROOT"
  if [[ -n "$(ls -A "$ROOT")" && ! -e "$ROOT/$MARKER" ]]; then
    die "$ROOT is not empty and was not created by this script"
  fi
  touch "$ROOT/$MARKER"
  # A socket path is bounded by sun_path (107 bytes): the longest one is a
  # worker's hook socket, `<root>/rt/pohunek/workers/s-<26 chars>/.s<16 chars>`,
  # 67 bytes below the root.
  ((${#ROOT} <= 40)) || die "--root is too long for the worker socket path (${#ROOT} > 40)"
  CLINE_PREFIX="$(cd "$CLINE_PREFIX" && pwd -P)"
  [[ -x "$CLINE_PREFIX/bin/cline" ]] || die "$CLINE_PREFIX is not a Cline prefix"
  wrapper="$CLINE_PREFIX/lib/node_modules/cline"
  [[ "$(jq -r .version "$wrapper/package.json")" == "$RELEASE" ]] ||
    die "$CLINE_PREFIX holds Cline $(jq -r .version "$wrapper/package.json"), compat/RELEASE locks $RELEASE"
  [[ "$(sha256sum "$wrapper/node_modules/@cline/cli-linux-x64/bin/cline" | cut -d' ' -f1)" == "$BIN_SHA" ]] ||
    die "the binary under $CLINE_PREFIX does not match the sha256 in compat/RELEASE"
  rm -rf "${ROOT:?}/prefix" "${ROOT:?}/shim" "${ROOT:?}/home" "${ROOT:?}/rt" "${ROOT:?}/cline" "${ROOT:?}/ws" "${ROOT:?}/stage" \
    "${ROOT:?}/daemon.log" "${ROOT:?}/stub" "${ROOT:?}/hub"
  mkdir -p "$ROOT/prefix"
  cp -a "$CLINE_PREFIX/." "$ROOT/prefix/"
  # Hub daemons of other installations (the operator's own) must survive.
  before_hubs="$(pgrep -f -- '--cline-hub-daemon' | sort | tr '\n' ' ' || true)"
  rc=0
  SMOKE_STAGE=outer SMOKE_HOST_HOME="$HOME" SMOKE_HOST_RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" \
    SMOKE_UID="$(id -u)" SMOKE_GID="$(id -g)" \
    unshare --user --map-root-user --net --mount --uts --pid --fork --kill-child \
    bash "${BASH_SOURCE[0]}" --root "$ROOT" --core-bin "$(cd "$CORE_BIN" && pwd -P)" \
    --cline-prefix "$ROOT/prefix" || rc=$?
  sleep 1
  after_hubs="$(pgrep -f -- '--cline-hub-daemon' | sort | tr '\n' ' ' || true)"
  [[ "$before_hubs" == "$after_hubs" ]] || die "the set of Cline hub daemons on the host changed: [$before_hubs] -> [$after_hubs]"
  ((rc == 0)) || exit "$rc"
  log "host: the set of Cline hub daemons is unchanged ([${before_hubs% }])"
  exit 0
fi

if [[ "$SMOKE_STAGE" == outer ]]; then
  ip link set lo up
  hostname smoke
  mount -t proc proc /proc
  # The operator's Cline home is covered by an empty tmpfs, so nothing here
  # can read or write it even through a default path.
  if [[ -d "$SMOKE_HOST_HOME/.cline" ]]; then
    mount -t tmpfs -o size=1m,mode=0700 tmpfs "$SMOKE_HOST_HOME/.cline"
  fi
  # The operator's daemon socket lives below the host runtime dir, which the
  # mount namespace still shows and the inner user namespace maps back to the
  # same uid.
  if [[ -d "$SMOKE_HOST_RUNTIME/pohunek" ]]; then
    mount -t tmpfs -o size=1m,mode=0700 tmpfs "$SMOKE_HOST_RUNTIME/pohunek"
  fi
  SMOKE_STAGE=inner exec unshare --user --map-user="$SMOKE_UID" --map-group="$SMOKE_GID" \
    bash "${BASH_SOURCE[0]}" --root "$ROOT" --core-bin "$CORE_BIN" --cline-prefix "$CLINE_PREFIX"
fi

# --- inner stage: the run -------------------------------------------------

HOME_DIR="$ROOT/home"
RT_DIR="$ROOT/rt"
WS="$ROOT/ws"
CLINE_DIR_PATH="$ROOT/cline"
CLINE_DATA="$CLINE_DIR_PATH/data"
HUB_DISCOVERY="$ROOT/hub/discovery.json"
mkdir -p "$HOME_DIR/.config/pohunek/agents" "$HOME_DIR/.local/share" "$HOME_DIR/.local/state" \
  "$WS" "$ROOT/stage" "$ROOT/stub" "$ROOT/hub" "$CLINE_DATA/settings"
mkdir -p "$RT_DIR"
chmod 700 "$RT_DIR" "$HOME_DIR/.config/pohunek" "$HOME_DIR/.config/pohunek/agents"
# No env opt-out of telemetry exists; the setting is the only one.
printf '{\n  "telemetryOptOut": true,\n  "autoUpdateEnabled": false\n}\n' >"$CLINE_DATA/settings/global-settings.json"
git -C "$WS" init -q -b main .
printf '# smoke workspace\n' >"$WS/README.md"
git -C "$WS" add README.md
git -C "$WS" -c user.name=smoke -c user.email=smoke@example.invalid commit -q -m init

# The daemon probes `cline --version` with an empty private HOME and a 2 second
# deadline. In a namespace without a route out, Cline takes about 8 seconds to
# exit unless its settings opt out of telemetry (measured: 8.4 s without, 0.4 s
# with `telemetryOptOut`), and the probe cannot see this root's settings. The
# launcher below hands the probe and every session the same data root.
mkdir -p "$ROOT/shim"
cat >"$ROOT/shim/cline" <<SHIM
#!/bin/bash
export CLINE_DATA_DIR="$CLINE_DATA"
exec "$ROOT/prefix/bin/cline" "\$@"
SHIM
chmod +x "$ROOT/shim/cline"
AGENT_PATH="$ROOT/shim:$ROOT/prefix/bin:/usr/bin:/bin"

# Every command runs with a cleared environment, so nothing of the caller's
# POHUNEK_* or credential variables reaches the daemon, Cline or the CLI.
isolated() {
  env -i HOME="$HOME_DIR" XDG_CONFIG_HOME="$HOME_DIR/.config" XDG_DATA_HOME="$HOME_DIR/.local/share" \
    XDG_STATE_HOME="$HOME_DIR/.local/state" XDG_RUNTIME_DIR="$RT_DIR" TMPDIR="$ROOT/stage" \
    PATH="$AGENT_PATH" TERM=xterm-256color LANG=C.UTF-8 "$@"
}
pk() { isolated "$CORE_BIN/pohunek" "$@"; }

teardown() {
  local status=$?
  if [[ -n "$STUB_PID" ]]; then
    kill "$STUB_PID" 2>/dev/null || true
  fi
  if [[ -n "$DAEMON_PID" ]]; then
    kill "$DAEMON_PID" 2>/dev/null || true
    local i
    for ((i = 0; i < REAP_SECONDS * 2; i++)); do
      kill -0 "$DAEMON_PID" 2>/dev/null || break
      sleep "$POLL_SECONDS"
    done
    kill -0 "$DAEMON_PID" 2>/dev/null && kill -9 "$DAEMON_PID" 2>/dev/null || true
    wait "$DAEMON_PID" 2>/dev/null || true
  fi
  if ((status == 0)); then
    log "PASS"
  else
    log "exit $status (daemon log: $ROOT/daemon.log)"
  fi
}
trap teardown EXIT

assert_isolated() {
  local links
  links="$(ip -o link | awk -F': ' '{print $2}' | tr '\n' ' ')"
  [[ "$links" == "lo " ]] || die "network namespace is not loopback-only: $links"
  [[ "$(hostname)" == smoke ]] || die "host name is not isolated"
  if (exec 3<>/dev/tcp/127.0.0.1/25463) 2>/dev/null; then
    die "a listener on 127.0.0.1:25463 is reachable inside the namespace"
  fi
  [[ "$(ps -e -o pid= | wc -l)" -lt 20 ]] || die "the process namespace is not private"
  if [[ -d "$SMOKE_HOST_HOME/.cline" ]]; then
    [[ "$(stat -f -c %T "$SMOKE_HOST_HOME/.cline")" == tmpfs && -z "$(ls -A "$SMOKE_HOST_HOME/.cline")" ]] ||
      die "the operator's Cline home is not covered inside the namespace"
  fi
  if [[ -d "$SMOKE_HOST_RUNTIME/pohunek" ]]; then
    [[ "$(stat -f -c %T "$SMOKE_HOST_RUNTIME/pohunek")" == tmpfs && -z "$(ls -A "$SMOKE_HOST_RUNTIME/pohunek")" ]] ||
      die "the operator's pohunek runtime directory is not covered inside the namespace"
  fi
  [[ ! -S "$SMOKE_HOST_RUNTIME/pohunek/daemon.sock" ]] || die "the operator's daemon socket is visible inside the namespace"
}
assert_isolated
log "namespace: loopback only, private process tree, operator's Cline home and daemon runtime dir covered"

wait_for() { # <description> <command...>
  local what="$1" i
  shift
  for ((i = 0; i < WAIT_SECONDS * 2; i++)); do
    if "$@" >/dev/null 2>&1; then return 0; fi
    sleep "$POLL_SECONDS"
  done
  die "timed out waiting for $what"
}

# --- model stub ------------------------------------------------------------
# Replies are served in order across the run: the held first turn, the turn
# after resume, a command that needs approval (never answered), the turn
# beside a running hub, the reported-identity turns (first, after /clear,
# after /fork) and a subagent turn (the subagent's own request offers no
# `team_status` tool, which selects its reply).
jq -n --argjson hold "$HOLD_SECONDS" --arg cmd "touch $APPROVAL_MARKER" '[
  {text: "Smoke reply one.", delay: $hold},
  {text: "Smoke reply two."},
  {tool: "run_commands", args: {commands: [$cmd]}},
  {text: "Hub reply."},
  {text: "Identity reply one."},
  {text: "Identity reply clear."},
  {text: "Identity reply fork."},
  {tool: "spawn_agent", args: {systemPrompt: "You are a helper.", task: "Say done."}},
  {text: "Subagent says done.", unless_tool: "team_status"},
  {text: "Parent saw the subagent."}]' >"$ROOT/stub/script.json"
: >"$ROOT/stub/requests.jsonl"
python3 -I "$SCRIPT_DIR/model-stub" --port "$STUB_PORT" --script "$ROOT/stub/script.json" \
  --log "$ROOT/stub/requests.jsonl" 2>"$ROOT/stub/stub.err" &
STUB_PID=$!
stub_up() { (exec 3<>"/dev/tcp/127.0.0.1/$STUB_PORT"); }
wait_for "the model stub" stub_up

# Cline's provider configuration (an `openai` provider on the stub), written
# with the same variables the sessions get.
cline_env() {
  isolated CLINE_DIR="$CLINE_DIR_PATH" CLINE_DATA_DIR="$CLINE_DATA" CLINE_HUB_PORT="$HUB_PORT" \
    CLINE_HUB_DISCOVERY_PATH="$HUB_DISCOVERY" CLINE_NO_AUTO_UPDATE=1 "$@"
}
(cd "$WS" && cline_env cline auth -p openai -k "$STUB_KEY" -m "$STUB_MODEL" -b "http://127.0.0.1:$STUB_PORT/v1") \
  >"$ROOT/stage/auth.out" 2>&1 || die "cline auth failed: $(tail -n 3 "$ROOT/stage/auth.out")"

# --- daemon -----------------------------------------------------------------
isolated "$CORE_BIN/pohunek" daemon start --dev-subprocess >"$ROOT/daemon.log" 2>&1 &
DAEMON_PID=$!
wait_for "the isolated daemon" pk health
socket="$RT_DIR/pohunek/daemon.sock"
[[ -S "$socket" ]] || die "no daemon socket at $socket"
log "daemon is up on $socket"

# --- package under a development id ------------------------------------------
cp "$REPO/package/runtime.toml" "$REPO/package/detect.toml" "$ROOT/stage/"
sed -i 's/^id = "pohunek\.runtime\.cline"$/id = "dev.runtime.cline"/' "$ROOT/stage/runtime.toml"
grep -q '^id = "dev.runtime.cline"$' "$ROOT/stage/runtime.toml" || die "could not stage the development id"
pk plugin link "$ROOT/stage" --yes >/dev/null
digest="$(pk plugin list --json | jq -r '.ok.packages[0].digest')"
pk plugin enable dev.runtime.cline --digest "${digest#sha256:}" >/dev/null
pk plugin select dev.runtime.cline --digest "${digest#sha256:}" >/dev/null
pk plugin doctor | grep -q 'No problems found' || die "plugin doctor reports a problem"

# Profiles carry only what the harness decides: the isolated config home and
# data root, the hub port and discovery path. Local placement comes from the
# package's handler: core refuses a launch whose environment sets
# CLINE_SANDBOX or CLINE_SANDBOX_DATA_DIR, so none is set here. `cline-approve`
# also turns Cline's approval on, as the approval scenario needs.
profile() { # <name> <args toml>
  cat >"$HOME_DIR/.config/pohunek/agents/$1.toml" <<EOF
base = "cline"
package = "dev.runtime.cline"
digest = "$digest"
program = "cline"
args = $2
[env]
CLINE_DIR = "$CLINE_DIR_PATH"
CLINE_DATA_DIR = "$CLINE_DATA"
CLINE_HUB_PORT = "$HUB_PORT"
CLINE_HUB_DISCOVERY_PATH = "$HUB_DISCOVERY"
EOF
  chmod 600 "$HOME_DIR/.config/pohunek/agents/$1.toml"
}
profile cline-local '[]'
profile cline-approve '["--auto-approve", "false"]'
if grep -q CLINE_SANDBOX "$HOME_DIR"/.config/pohunek/agents/*.toml; then die "a profile sets a CLINE_SANDBOX variable"; fi

# --- foreign hooks, integration install ------------------------------------------
# Two observer hooks that are not Pohunek's: Cline runs a file named after an
# event with no suffix as well as `<event>.sh`, so they run beside the reporter
# and are not a name collision of the install. Each turn appends the
# process chain above the hook, CLINE_SANDBOX and the session id it carries.
# They print nothing, so Cline reads no control output from them.
HOOK_LOG="$ROOT/hooklog.txt"
HOOKS_DIR="$CLINE_DIR_PATH/hooks"
mkdir -p "$HOOKS_DIR"
: >"$HOOK_LOG"
for ev in TaskResume TaskComplete; do
  cat >"$HOOKS_DIR/$ev" <<OBSERVER
#!/bin/bash
payload="\$(cat)"
chain=""
p="\$PPID"
while [ -n "\$p" ] && [ "\$p" -gt 1 ]; do
  chain="\$chain \$p"
  p="\$(awk '/^PPid:/ {print \$2}' "/proc/\$p/status" 2>/dev/null)"
done
root="\$(printf '%s' "\$payload" | jq -r '.sessionContext.rootSessionId // empty')"
printf '%s sandbox=%s root=%s chain=%s\n' "$ev" "\${CLINE_SANDBOX:-}" "\$root" "\$chain" >>"$HOOK_LOG"
OBSERVER
  chmod +x "$HOOKS_DIR/$ev"
done
foreign_sums() { (cd "$HOOKS_DIR" && sha256sum ./TaskResume ./TaskComplete); }
foreign_before="$(foreign_sums)"
REPORTER_EVENTS=(TaskStart TaskResume TaskComplete TaskError TaskCancel SessionShutdown)
integration_json() { # <subcommand>
  pk integration "$1" --agent cline --profile cline-local --json
}
install_out="$(integration_json install)" || die "integration install failed: $install_out"
for ev in "${REPORTER_EVENTS[@]}"; do
  [[ -f "$HOOKS_DIR/$ev.sh" ]] || die "the reporter $ev.sh is not installed in $HOOKS_DIR"
  grep -q '^# POHUNEK_INTEGRATION_ID=cline$' "$HOOKS_DIR/$ev.sh" || die "$ev.sh lacks the ownership marker"
done
[[ "$(foreign_sums)" == "$foreign_before" ]] || die "install changed a foreign hook"
status_out="$(integration_json status)" || die "integration status failed: $status_out"
doctor_out="$(integration_json doctor)" || die "integration doctor failed: $doctor_out"
[[ "$(foreign_sums)" == "$foreign_before" ]] || die "status or doctor changed a foreign hook"
# Outside a Pohunek session (no POHUNEK_ENV) the reporter exits 0 at once and
# prints nothing, also with a payload. The payload comes from a here-string: the
# reporter does not read it, and a pipe would let `pipefail` see the SIGPIPE.
payload='{"hookName":"agent_resume","sessionContext":{"rootSessionId":"x"}}'
for ev in "${REPORTER_EVENTS[@]}"; do
  outside="$(env -i PATH="$AGENT_PATH" CLINE_SANDBOX=1 "$HOOKS_DIR/$ev.sh" 2>&1 <<<"$payload")" ||
    die "$ev.sh exited non-zero outside Pohunek: $outside"
  [[ -z "$outside" ]] || die "$ev.sh printed outside Pohunek: $outside"
done
log "install: the six reporter files carry the ownership marker and are silent no-ops outside Pohunek, foreign hooks unchanged"

activity_of() { pk session list --json | jq -r --arg n "$1" '.ok[] | select(.name == $n) | .activity // "none"'; }
session_id() { pk session list --json | jq -r --arg n "$1" '.ok[] | select(.name == $n) | .id'; }
root_pid_of() { pk session list --json | jq -r --arg n "$1" '.ok[] | select(.name == $n) | .pid'; }
native_of() { pk session list --json | jq -r --arg n "$1" '.ok[] | select(.name == $n) | .native_session_id // empty'; }
want_activity() { [[ "$(activity_of "$1")" == "$2" ]]; }
# The screen is read to the end before grep, so an early `grep -q` exit cannot
# break the pipe under `pipefail`.
screen_has() {
  local screen
  screen="$(pk session screen "$1")" || return 1
  grep -q -- "$2" <<<"$screen"
}
cmdline_of() { tr '\0' ' ' <"/proc/$1/cmdline"; }
assert_no_hub() {
  if pgrep -f -- '--cline-hub-daemon' >/dev/null 2>&1; then die "$1: a Cline hub daemon is running"; fi
}

# --- D2: bare launch reaches idle, no promo modal ------------------------------
pk session new --agent cline-local --cwd "$WS" --name bare --yes >/dev/null
wait_for "the bare session to read idle" want_activity bare idle
bare_id="$(session_id bare)"
bare_pid="$(root_pid_of bare)"
for name in CLINE_NO_AUTO_UPDATE=1 CLINE_DISABLE_CLINE_PASS_NOTICE=1 CLINE_SANDBOX=1 "CLINE_SANDBOX_DATA_DIR=$CLINE_DATA"; do
  tr '\0' '\n' <"/proc/$bare_pid/environ" | grep -qx "$name" || die "$name is not in the launch environment"
done
if pk session screen "$bare_id" | grep -Eq 'Try ClinePass|Cline Desktop|Press Enter to open'; then
  die "a promo modal shows"
fi
[[ ! -e "$CLINE_DATA/settings/cli-notices.json" ]] || die "Cline recorded a promo notice"
assert_no_hub "bare launch"
pk session stop "$bare_id" >/dev/null
log "D2: launch with the local-runtime variables reads idle, update and promo variables set, no promo modal, no hub daemon"

# --- D3, D4: initial input reaches the composer; a stub turn reads working, then idle
pk session new --agent cline-local --cwd "$WS" --name turn --input "$PROMPT" \
  --input-ack-timeout-ms "$INPUT_ACK_MS" --yes --json >"$ROOT/stage/turn-new.json"
[[ "$(jq -r '.ok.prompt_delivered' "$ROOT/stage/turn-new.json")" == "true" ]] || die "the initial input did not start a turn"
turn_id="$(jq -r '.ok.id' "$ROOT/stage/turn-new.json")"
turn_pid="$(root_pid_of turn)"
turn_native="$(native_of turn)"
[[ -n "$turn_native" ]] || die "the session has no native reference"
[[ "$(cmdline_of "$turn_pid")" == *" --id $turn_native "* ]] || die "unexpected launch arguments: $(cmdline_of "$turn_pid")"
seen_working=""
for ((i = 0; i < WAIT_SECONDS * 4; i++)); do
  if want_activity turn working; then
    seen_working=1
    break
  fi
  sleep "$FAST_POLL_SECONDS"
done
[[ -n "$seen_working" ]] || die "the stub turn never read working"
screen_has "$turn_id" "$PROMPT" || die "the initial input is not on the screen"
reply_one() { screen_has "$turn_id" 'Smoke reply one'; }
wait_for "the stub reply on screen" reply_one
wait_for "the turn session to read idle" want_activity turn idle
assert_no_hub "turn session"
log "D3: the initial input started a turn (prompt_delivered), launched as cline --id $turn_native"
log "D4: the stub turn read working, then idle"

# --- D6: resume shows the conversation; recovery needs <id>/<id>.json -----------
manifest="$CLINE_DATA/sessions/$turn_native/$turn_native.json"
[[ -f "$manifest" ]] || die "no session manifest at $manifest"
pk session stop "$turn_id" >/dev/null
pk session resume "$turn_id" >/dev/null
wait_for "the resumed session to read idle" want_activity turn idle
resumed_pid="$(root_pid_of turn)"
[[ "$(cmdline_of "$resumed_pid")" == *" --id $turn_native "* ]] || die "unexpected resume arguments: $(cmdline_of "$resumed_pid")"
screen_has "$turn_id" "$PROMPT" || die "the resumed screen does not show the prompt"
screen_has "$turn_id" 'Smoke reply one' || die "the resumed screen does not show the earlier reply"
pk session input "$turn_id" "after resume" >/dev/null
reply_two() { screen_has "$turn_id" 'Smoke reply two'; }
wait_for "the reply after resume" reply_two
wait_for "the resumed session to read idle again" want_activity turn idle
assert_no_hub "resumed session"
[[ "$(native_of turn)" == "$turn_native" ]] || die "the resumed session changed its native reference"
pk session stop "$turn_id" >/dev/null
# The bare session never took a prompt, so Cline wrote no <id>/<id>.json for
# its assigned reference and no hook reported it. For a session that did take a
# prompt, core 0.44.0 does not check a reported reference, so this refusal is
# not asserted for it (zajca/pohunek#2528).
refusal="$(pk session resume "$bare_id" --json || true)"
[[ "$(jq -r '.err.code' <<<"$refusal")" == agent_native_reference_missing ]] ||
  die "resume of a session without a manifest was not refused: $refusal"
log "D6: resume relaunched cline --id $turn_native and showed the conversation; a session without <id>/<id>.json was refused"

# --- D5: blocked on approval, plain text refused ---------------------------------
pk session new --agent cline-approve --cwd "$WS" --name approval --yes >/dev/null
wait_for "the approval session to read idle" want_activity approval idle
approval_id="$(session_id approval)"
pk session input "$approval_id" "run a command" >/dev/null
approval_seen() { screen_has "$approval_id" 'Cline needs permission'; }
wait_for "the approval box" approval_seen
wait_for "the approval session to read blocked" want_activity approval blocked
assert_no_hub "approval session"
screen_has "$approval_id" 'Auto-approve all disabled' || die "approval is not on"
refusal="$(pk session input "$approval_id" "hello" --json || true)"
[[ "$(jq -r '.err.code' <<<"$refusal")" == session_input_blocked ]] || die "input reached the approval box: $refusal"
sleep "$REFUSAL_SETTLE_SECONDS"
[[ ! -e "$WS/$APPROVAL_MARKER" ]] || die "the command ran without the operator"
approval_seen || die "the approval box was answered without the operator"
want_activity approval blocked || die "the approval session left blocked"
pk session stop "$approval_id" >/dev/null
log "D5: the stub run_commands read blocked under approval, plain text was refused (session_input_blocked), the command did not run"

assert_no_hub "after the sessions without a hub"
log "P2-D3: no Cline hub daemon existed before, during or after any launch of the sessions above"

# --- P2-D1: a compatible hub is running; the launch stays local -------------------
hub_pids() { pgrep -f -- '--cline-hub-daemon' | sort | tr '\n' ' ' || true; }
ancestors_of() { # <pid>: the pids above it, nearest first
  local p="$1" out=""
  while [[ -n "$p" && "$p" -gt 1 ]]; do
    out="$out $p"
    p="$(awk '/^PPid:/ {print $2}' "/proc/$p/status" 2>/dev/null)"
  done
  printf '%s' "$out"
}
(cd "$WS" && cline_env cline hub start --port "$HUB_PORT" --json) >"$ROOT/stage/hub-start.json" 2>&1 ||
  die "cline hub start failed: $(tail -n 3 "$ROOT/stage/hub-start.json")"
hub_up() { [[ -n "$(hub_pids)" ]]; }
wait_for "the isolated Cline hub" hub_up
# The hub must be usable, or a local launch beside it proves nothing: it
# reports its URL on the private port, writes the discovery record and listens.
jq -e --arg url "ws://127.0.0.1:$HUB_PORT/hub" '.url == $url' "$ROOT/stage/hub-start.json" >/dev/null ||
  die "the hub did not report the private port: $(jq -c 'del(.authToken)' "$ROOT/stage/hub-start.json")"
[[ -s "$HUB_DISCOVERY" ]] || die "the hub wrote no discovery record at $HUB_DISCOVERY"
hub_listens() { (exec 3<>"/dev/tcp/127.0.0.1/$HUB_PORT"); }
wait_for "the hub to listen on $HUB_PORT" hub_listens
hubs_before="$(hub_pids)"
hook_lines_before="$(wc -l <"$HOOK_LOG")"
pk session new --agent cline-local --cwd "$WS" --name hubhost --input "hub turn" \
  --input-ack-timeout-ms "$INPUT_ACK_MS" --yes --json >"$ROOT/stage/hubhost-new.json"
hubhost_id="$(jq -r '.ok.id' "$ROOT/stage/hubhost-new.json")"
hubhost_pid="$(root_pid_of hubhost)"
hub_reply() { screen_has "$hubhost_id" 'Hub reply'; }
wait_for "the reply of the session beside the hub" hub_reply
hook_logged() { # <event> <first line number to look at>
  tail -n "+$2" "$HOOK_LOG" | grep -q "^$1 "
}
wait_for "the foreign TaskComplete hook of the hub-side session" hook_logged TaskComplete "$((hook_lines_before + 1))"
[[ "$(hub_pids)" == "$hubs_before" ]] || die "the launch changed the set of Cline hub daemons: [$hubs_before] -> [$(hub_pids)]"
new_hook_lines="$(tail -n "+$((hook_lines_before + 1))" "$HOOK_LOG")"
[[ -n "$new_hook_lines" ]] || die "no hook ran for the session beside the hub"
while IFS= read -r line; do
  [[ "$line" == *" sandbox=1 "* ]] || die "a hook of the session beside the hub ran without CLINE_SANDBOX=1: $line"
  [[ " ${line##*chain=} " == *" $hubhost_pid "* ]] || die "a hook is not below the TUI process $hubhost_pid: $line"
done <<<"$new_hook_lines"
for pid in $hubs_before; do
  [[ " $(ancestors_of "$pid") " != *" $hubhost_pid "* ]] || die "the hub daemon $pid runs below the session"
done
wait_for "the hub-side session to read idle" want_activity hubhost idle
placement_outcome="$(pk session inspect "$hubhost_id" --json | jq -r '.ok.placement.outcome')"
[[ "$placement_outcome" == clean ]] || die "core reports placement '$placement_outcome' for the session beside the hub"
pk session stop "$hubhost_id" >/dev/null
[[ "$(hub_pids)" == "$hubs_before" ]] || die "stopping the session changed the set of Cline hub daemons"
log "P2-D1: with a compatible hub running ([${hubs_before% }]) the launch ran local: every hook below the TUI ($hubhost_pid) with CLINE_SANDBOX=1, placement clean, hub set unchanged during and after the session"
(cd "$WS" && cline_env cline hub stop) >"$ROOT/stage/hub-stop.txt" 2>&1 || die "cline hub stop failed: $(tail -n 3 "$ROOT/stage/hub-stop.txt")"
hub_gone() { [[ -z "$(hub_pids)" ]]; }
wait_for "the isolated Cline hub to end" hub_gone

# --- P2-D2: reported reference follows /clear and /fork; a subagent is reported ------
ident_mark="$(wc -l <"$HOOK_LOG")"
pk session new --agent cline-local --cwd "$WS" --name ident --input "identity turn" \
  --input-ack-timeout-ms "$INPUT_ACK_MS" --yes --json >"$ROOT/stage/ident-new.json"
ident_id="$(jq -r '.ok.id' "$ROOT/stage/ident-new.json")"
ident_assigned="$(native_of ident)"
ident_reply() { screen_has "$ident_id" "$1"; }
hook_mark() { wc -l <"$HOOK_LOG"; }
# The session id of the newest foreign TaskComplete hook after line <mark>,
# waited for: it is what the turn's hooks carried, in TURN_ROOT.
await_root() { # <mark>
  local i
  for ((i = 0; i < WAIT_SECONDS * 2; i++)); do
    TURN_ROOT="$(tail -n "+$(($1 + 1))" "$HOOK_LOG" | grep '^TaskComplete ' | tail -n 1 | grep -o 'root=[^ ]*' | cut -d= -f2 || true)"
    [[ -z "$TURN_ROOT" ]] || return 0
    sleep "$POLL_SECONDS"
  done
  die "no TaskComplete hook after line $1 of the hook log"
}
# Both the reference and the agent's own session id follow <root>.
ident_follows() { # <root>
  local inspected
  inspected="$(pk session inspect "$ident_id" --json)" || return 1
  jq -e --arg r "$1" '.ok.native_session_id == $r and .ok.active_agent_session_id == $r' >/dev/null <<<"$inspected"
}
wait_for "the first identity reply" ident_reply 'Identity reply one'
wait_for "the identity session to read idle" want_activity ident idle
await_root "$ident_mark"
[[ "$TURN_ROOT" == "$ident_assigned" ]] || die "the first turn reported $TURN_ROOT, not the launch id $ident_assigned"
wait_for "the reported reference" ident_follows "$TURN_ROOT"
log "P2-D2: after one stub turn the reference and the agent session id are the id the TUI reported ($ident_assigned)"

mark="$(hook_mark)"
pk session input "$ident_id" "/clear" >/dev/null
wait_for "the cleared screen" ident_reply 'What can I do for you'
pk session input "$ident_id" "after clear" >/dev/null
wait_for "the reply after /clear" ident_reply 'Identity reply clear'
wait_for "the session to read idle after /clear" want_activity ident idle
await_root "$mark"
cleared="$TURN_ROOT"
[[ "$cleared" != "$ident_assigned" ]] || die "/clear did not start a new session id (hook root: $cleared)"
wait_for "the reference to follow /clear" ident_follows "$cleared"
log "P2-D2: /clear re-bound the reference $ident_assigned -> $cleared"

mark="$(hook_mark)"
pk session input "$ident_id" "/fork" >/dev/null
wait_for "the fork confirmation" ident_reply 'Create a fork of the current'
# `session input` is refused while the confirmation shows (the descriptor's
# refuse_while_blocked), so the operator's own route answers it: Enter through
# `pohunek attach` with a piped stdin.
printf '\r' | timeout "$WAIT_SECONDS" env -i HOME="$HOME_DIR" XDG_CONFIG_HOME="$HOME_DIR/.config" \
  XDG_DATA_HOME="$HOME_DIR/.local/share" XDG_STATE_HOME="$HOME_DIR/.local/state" XDG_RUNTIME_DIR="$RT_DIR" \
  TMPDIR="$ROOT/stage" PATH="$AGENT_PATH" TERM=xterm-256color LANG=C.UTF-8 \
  "$CORE_BIN/pohunek" attach "$ident_id" >/dev/null 2>&1 || true
wait_for "the fork notice" ident_reply 'Forked into new session'
pk session input "$ident_id" "after fork" >/dev/null
wait_for "the reply after /fork" ident_reply 'Identity reply fork'
wait_for "the session to read idle after /fork" want_activity ident idle
await_root "$mark"
forked="$TURN_ROOT"
[[ "$forked" != "$cleared" ]] || die "/fork did not start a new session id (hook root: $forked)"
wait_for "the reference to follow /fork" ident_follows "$forked"
log "P2-D2: /fork re-bound the reference $cleared -> $forked"

pk session input "$ident_id" "spawn a helper" >/dev/null
wait_for "the parent's reply after the subagent" ident_reply 'Parent saw the subagent'
wait_for "the session to read idle after the subagent turn" want_activity ident idle
subagent_reported() {
  local inspected
  inspected="$(pk session inspect "$ident_id" --json)" || return 1
  jq -e '[.ok.subagents[]? | select(.provider == "cline" and .lifecycle == "completed" and (.parent_id | type == "string"))] | length == 1' \
    >/dev/null <<<"$inspected"
}
wait_for "the completed subagent to be reported" subagent_reported
assert_no_hub "while the identity session ran"
log "P2-D2: the subagent turn was reported (one cline subagent with a parent id, lifecycle completed)"
pk session stop "$ident_id" >/dev/null

# --- P2-D4: uninstall removes only the reporter; the foreign hooks stay byte-identical
uninstall_out="$(integration_json uninstall)" || die "integration uninstall failed: $uninstall_out"
for ev in "${REPORTER_EVENTS[@]}"; do
  [[ ! -e "$HOOKS_DIR/$ev.sh" ]] || die "uninstall left $ev.sh"
done
[[ -d "$HOOKS_DIR" ]] || die "uninstall removed the hooks directory"
[[ "$(foreign_sums)" == "$foreign_before" ]] || die "uninstall changed a foreign hook"
log "P2-D4: install, status, doctor and uninstall left the foreign hooks byte-identical; uninstall removed the six reporter files"

assert_no_hub "end of run"
log "stub served: $(jq -r '[.reply] | @csv' "$ROOT/stub/requests.jsonl" | tr '\n' ' ')"
