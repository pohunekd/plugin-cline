#!/usr/bin/env python3
"""Loopback OpenAI-compatible chat-completions stub for model-free Cline runs.

usage: scripts/model-stub --port PORT --script FILE --log FILE

Cline reaches it through an `openai` provider whose base URL is
http://127.0.0.1:PORT/v1. It binds 127.0.0.1 only and needs no third-party code.

FILE is a JSON list of replies. Each request is answered with the first reply
that is not used up and whose conditions match; with none left the stub sends
the text "Stub reply.". A reply is one of

  {"text": "..."}                              streamed assistant text
  {"tool": "<name>", "args": {...}}           one streamed tool call
  {"error": <http status>, "message": "..."}  an error response

with these optional keys:

  "times": N            serve the reply N times (default 1)
  "delay": S            wait S seconds after the first chunk (working state)
  "when_tool": "<name>" match only requests that offer this tool
  "unless_tool": "<n>"  match only requests that do not offer this tool

The log gets one JSON line per request: method, path, the reply index served
and the names of the tools the request offered. Message content is never logged.
"""

import argparse
import json
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

FALLBACK = {"text": "Stub reply."}
MODEL_ID = "stub-model"


def parse_args():
    parser = argparse.ArgumentParser(description="loopback chat-completions stub")
    parser.add_argument("--port", type=int, required=True)
    parser.add_argument("--script", required=True)
    parser.add_argument("--log", required=True)
    return parser.parse_args()


class Script:
    """The scripted replies and how often each has been served."""

    def __init__(self, path):
        with open(path, encoding="utf-8") as fh:
            self.replies = json.load(fh)
        if not isinstance(self.replies, list):
            raise SystemExit("model-stub: the script must be a JSON list")
        self.served = [0] * len(self.replies)
        self.lock = threading.Lock()

    def take(self, offered_tools):
        with self.lock:
            for index, reply in enumerate(self.replies):
                if self.served[index] >= reply.get("times", 1):
                    continue
                if "when_tool" in reply and reply["when_tool"] not in offered_tools:
                    continue
                if "unless_tool" in reply and reply["unless_tool"] in offered_tools:
                    continue
                self.served[index] += 1
                return index, reply
            return None, FALLBACK


def chunk(delta, finish=None):
    return {
        "id": "chatcmpl-stub",
        "object": "chat.completion.chunk",
        "created": int(time.time()),
        "model": MODEL_ID,
        "choices": [{"index": 0, "delta": delta, "finish_reason": finish}],
    }


def make_handler(script, log_path):
    log_lock = threading.Lock()

    def log(entry):
        with log_lock, open(log_path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(entry, sort_keys=True) + "\n")

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *_args):
            pass

        def send_json(self, status, body):
            data = json.dumps(body).encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            log({"method": "GET", "path": self.path})
            if self.path.rstrip("/").endswith("/models"):
                self.send_json(200, {"object": "list", "data": [{"id": MODEL_ID, "object": "model"}]})
            else:
                self.send_json(404, {"error": {"message": "not found"}})

        def do_POST(self):
            length = int(self.headers.get("Content-Length") or 0)
            raw = self.rfile.read(length)
            try:
                body = json.loads(raw or b"{}")
            except json.JSONDecodeError:
                body = {}
            tools = sorted(
                t.get("function", {}).get("name", "") for t in body.get("tools") or [] if isinstance(t, dict)
            )
            index, reply = script.take(set(tools))
            kind = "error" if "error" in reply else "tool" if "tool" in reply else "text"
            log({"method": "POST", "path": self.path, "reply": index, "kind": kind, "tools": tools})
            if kind == "error":
                self.send_json(int(reply["error"]), {"error": {"message": reply.get("message", "stub error")}})
                return
            try:
                self.stream(index, reply)
            except (BrokenPipeError, ConnectionResetError):
                # The client cancelled the turn mid-stream.
                log({"method": "POST", "path": self.path, "reply": index, "kind": "client-closed"})

        def stream(self, index, reply):
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Connection", "close")
            self.end_headers()
            self.close_connection = True
            events = [chunk({"role": "assistant", "content": ""})]
            if "tool" in reply:
                call = {
                    "index": 0,
                    "id": "call_%d" % (index if index is not None else 0),
                    "type": "function",
                    "function": {"name": reply["tool"], "arguments": json.dumps(reply.get("args", {}))},
                }
                events.append(chunk({"tool_calls": [call]}))
                events.append(chunk({}, "tool_calls"))
            else:
                events.append(chunk({"content": reply["text"]}))
                events.append(chunk({}, "stop"))
            events.append(
                {
                    "id": "chatcmpl-stub",
                    "object": "chat.completion.chunk",
                    "created": int(time.time()),
                    "model": MODEL_ID,
                    "choices": [],
                    "usage": {"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15},
                }
            )
            for position, event in enumerate(events):
                if position == 1 and reply.get("delay"):
                    time.sleep(float(reply["delay"]))
                self.wfile.write(b"data: " + json.dumps(event).encode() + b"\n\n")
                self.wfile.flush()
            self.wfile.write(b"data: [DONE]\n\n")
            self.wfile.flush()

    return Handler


def main():
    args = parse_args()
    script = Script(args.script)
    server = ThreadingHTTPServer(("127.0.0.1", args.port), make_handler(script, args.log))
    server.daemon_threads = True
    print("model-stub: listening on 127.0.0.1:%d" % args.port, file=sys.stderr, flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
